set(args "${CASES}/worked-example.lp")
set(expected_exit 0)
set(expected_status optimal)
set(expected_objective 10)
set(expected_x 2)
set(expected_y 2)

if(SCENARIO STREQUAL "stdin")
    set(args -)
    set(input INPUT_FILE "${CASES}/negative-b.lp")
    set(expected_objective 4)
    set(expected_x 1)
elseif(SCENARIO STREQUAL "invalid")
    set(malformed "${CMAKE_CURRENT_BINARY_DIR}/malformed.lp")
    file(WRITE "${malformed}" "LP1 max 1 1\n1\n1 1\nunexpected\n")
    set(args "${malformed}")
    set(expected_exit 2)
    set(expected_status invalid_input)
elseif(SCENARIO STREQUAL "bad_option")
    set(args --tolerance nan)
    set(expected_exit 2)
    set(expected_status invalid_input)
elseif(SCENARIO STREQUAL "limit")
    list(PREPEND args --max-iterations 0)
    set(expected_status iteration_limit)
endif()

execute_process(COMMAND "${CLI}" ${args} ${input}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 10)
if(NOT "${code}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "Unexpected exit ${code}: ${diagnostic}\n${output}")
endif()
string(JSON status GET "${output}" status)
string(JSON variables LENGTH "${output}" variables)
if(NOT status STREQUAL expected_status)
    message(FATAL_ERROR "Unexpected status: ${output}")
endif()
if(status STREQUAL "optimal")
    string(JSON objective GET "${output}" objective)
    string(JSON x GET "${output}" variables 0)
    string(JSON y GET "${output}" variables 1)
    if(NOT (variables EQUAL 2 AND objective EQUAL expected_objective AND
            x EQUAL expected_x AND y EQUAL expected_y))
        message(FATAL_ERROR "Unexpected optimal solution: ${output}")
    endif()
else()
    string(JSON objective TYPE "${output}" objective)
    string(JSON iterations GET "${output}" iterations)
    if(NOT (variables EQUAL 0 AND objective STREQUAL "NULL" AND iterations EQUAL 0))
        message(FATAL_ERROR "Unexpected nonoptimal result: ${output}")
    endif()
endif()
